# Copy to .env.app and replace the secrets and initial owner credentials.
# Generate each random hex secret with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-hex-secret
JWT_SECRET=replace-with-another-random-hex-secret-at-least-32-characters
OWNER_USERNAME=owner
OWNER_PASSWORD=replace-with-a-strong-owner-password

# Use development for HTTP login; production requires HTTPS. Worker stays production.
API_NODE_ENV=production
# Optional. Set both after validating the model with the drafting evaluation.
OPENAI_API_KEY=
OPENAI_MODEL=

# Append DOCKER_GID using the stat command in README.md.
# No host account is needed: application UID/GID default to 1000:1000.
# Optional overrides: SERVICE_UID, SERVICE_GID, STORAGE_ROOT, LOG_ROOT,
# and COMPILER_IMAGE. Default storage/log paths are /srv/automemorydoll/{data,logs}.

# Approved starting profile for a 2 GiB RAM / 2 CPU host; verify under real load.
# Memory and tmpfs values are MiB. Tmpfs usage counts within the RAM ceiling.
# Storage initialization, migrations and owner bootstrap reuse the API limits.
# Memory-plus-swap equals memory: services cannot consume additional host swap.
API_CPUS=0.5
API_MEMORY_MB=256
API_PIDS=64
API_TMP_MB=32
WORKER_CPUS=0.5
WORKER_MEMORY_MB=256
WORKER_PIDS=64
WORKER_TMP_MB=32
POSTGRES_CPUS=0.75
POSTGRES_MEMORY_MB=384
POSTGRES_PIDS=128
POSTGRES_TMP_MB=32
REDIS_CPUS=0.25
REDIS_MEMORY_MB=128
REDIS_PIDS=32
FRONTEND_CPUS=0.25
FRONTEND_MEMORY_MB=128
FRONTEND_PIDS=32
FRONTEND_TMP_MB=64

# The compiler-image startup check reuses these CPU/memory/PID limits.
COMPILER_CPUS=1
COMPILER_MEMORY_MB=512
COMPILER_PIDS=64
COMPILER_WALL_TIME_MS=60000
WORKER_STOP_GRACE_PERIOD=90s
