generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String             @id @default(uuid()) @db.Uuid
  username      String             @unique
  displayId     String             @map("display_id")
  passwordHash  String             @map("password_hash")
  role          String             @default("user")
  disabled      Boolean            @default(false)
  tokenVersion  Int                @default(0) @map("token_version")
  createdAt     DateTime?          @default(now()) @map("created_at") @db.Timestamptz(6)
  templates     Template[]
  jobs          GenerationJob[]
  datasets      Dataset[]
  templateViews TemplateViewedAt[]

  @@map("users")
}

model Dataset {
  id           String       @id @default(uuid()) @db.Uuid
  ownedBy      String       @map("owned_by") @db.Uuid
  owner        User         @relation(fields: [ownedBy], references: [id])
  name         String
  columns      Json         @db.JsonB
  lastPosition Int          @default(0) @map("last_position")
  rowCount     Int          @default(0) @map("row_count")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  rows         DatasetRow[]

  @@index([ownedBy])
  @@map("datasets")
}

model DatasetRow {
  id        String  @id @default(uuid()) @db.Uuid
  datasetId String  @map("dataset_id") @db.Uuid
  dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  position  Int
  rank      String
  values    Json    @db.JsonB

  @@unique([datasetId, position])
  @@unique([datasetId, rank])
  @@map("dataset_rows")
}

model Template {
  id        String             @id @default(uuid()) @db.Uuid
  ownedBy   String             @map("owned_by") @db.Uuid
  owner     User               @relation(fields: [ownedBy], references: [id])
  name      String
  manifest  Json               @db.JsonB
  deletedAt DateTime?          @map("deleted_at") @db.Timestamptz(6)
  jobs      GenerationJob[]
  views     TemplateViewedAt[]

  @@index([ownedBy])
  @@map("templates")
}

model TemplateViewedAt {
  templateId String   @map("template_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  viewedAt   DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([templateId, userId])
  @@index([userId])
  @@map("template_viewed_at")
}

model GenerationJob {
  id          String    @id @default(uuid()) @db.Uuid
  templateId  String    @map("template_id") @db.Uuid
  template    Template  @relation(fields: [templateId], references: [id])
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id])
  batchCount  Int       @default(1) @map("batch_count")
  timestamp   DateTime  @default(now()) @db.Timestamptz(6)
  status      String    @default("queued")
  message     String
  pdfFilename String?   @map("pdf_filename")
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([userId, timestamp])
  @@map("generation_jobs")
}

model Setting {
  key   String @id
  value Json   @db.JsonB

  @@map("settings")
}

model AiQuotaReservation {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  month          DateTime @db.Date
  reservedTokens BigInt   @map("reserved_tokens")
  settledTokens  BigInt?  @map("settled_tokens")

  @@index([month, userId])
  @@map("ai_quota_reservations")
}

model AiAppMonthlyUsage {
  month      DateTime @id @db.Date
  usedTokens BigInt   @map("used_tokens")

  @@map("ai_app_monthly_usage")
}

model AiUserMonthlyUsage {
  month      DateTime @db.Date
  userId     String   @map("user_id") @db.Uuid
  usedTokens BigInt   @map("used_tokens")

  @@id([month, userId])
  @@map("ai_user_monthly_usage")
}
