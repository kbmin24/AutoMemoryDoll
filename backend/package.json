{
  "name": "@automemorydoll/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "bash scripts/run-service.sh api",
    "create-owner": "tsx src/cli/create-owner.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate:dev": "prisma migrate dev --config prisma7.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "worker": "bash scripts/run-service.sh worker"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/multer": "^2.3.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.5.4",
    "express": "^5.3.0",
    "express-validator": "^7.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.14",
    "multer": "^2.5.0",
    "pg": "8.16.3",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  }
}
