{
  "name": "automemorydoll",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "RUN_MVP_E2E=1 npm --workspace backend test -- mvp-e2e.test.ts",
    "services:up": "docker compose -f compose.dev.yaml up -d --wait",
    "services:down": "docker compose -f compose.dev.yaml down",
    "worker": "npm --workspace backend run worker --",
    "dev:backend": "npm --workspace backend run start --",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:all": "exec bash scripts/dev-all.sh",
    "build:frontend": "npm --workspace frontend run build",
    "previews:backfill": "npm --workspace backend run previews:backfill --"
  },
  "engines": {
    "node": ">=24"
  }
}
